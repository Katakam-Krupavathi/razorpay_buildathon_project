{
  "name": "autonomous-revenue-recovery-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @recovery/scripts",
    "db:reset": "npm run db:reset -w @recovery/scripts",
    "db:seed": "npm run db:seed -w @recovery/scripts",
    "seed:synthetic": "npm run seed:synthetic -w @recovery/scripts",
    "risk:analyze": "npm run risk:analyze -w @recovery/scripts",
    "planner:batch": "npm run planner:batch -w @recovery/scripts",
    "policy:batch": "npm run policy:batch -w @recovery/scripts",
    "pipeline:batch": "npm run pipeline:batch -w @recovery/scripts",
    "cb:simulate": "npm run cb:simulate -w @recovery/scripts",
    "audit:compliance": "npm run audit:compliance -w @recovery/scripts",
    "razorpay:seed-test-data": "npm run razorpay:seed-test-data -w @recovery/scripts",
    "demo:bootstrap": "npm run demo:bootstrap -w @recovery/scripts",
    "demo": "npm run demo:bootstrap -w @recovery/scripts && npm run dev",
    "dev": "concurrently -n \"server,web\" -c \"blue,green\" \"npm run dev -w @recovery/server\" \"npm run dev -w @recovery/web\"",
    "clean": "rimraf dist build **/dist **/build **/node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.10",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5"
  }
}
