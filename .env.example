# ==============================================================================
# Autonomous Revenue Recovery Control Plane - Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Dashboard / Web App
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME="Razorpay Recovery Control Plane"

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recovery_control_plane?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recovery_control_plane
POSTGRES_PORT=5432

# Redis Cache & Circuit Breaker Store
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Razorpay API Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Recovery Control Plane Safety Invariants & Thresholds
MAX_DAILY_RECOVERY_ATTEMPTS=500
MAX_PER_CUSTOMER_RECOVERY_ATTEMPTS=3
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENTAGE=15
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000
ERV_MINIMUM_CONFIDENCE_THRESHOLD=0.40

# JWT & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
SESSION_SECRET=super_secret_session_key_change_in_production
